# 複製成 .env 再改。.env 不進版控,每台機器各自維護一份。
#
#   cp .env.example .env
#   sed -i "s|^SECRET_KEY_BASE=.*|SECRET_KEY_BASE=$(openssl rand -hex 64)|" .env
#   # 然後把 ADMIN_PASSWORD 改掉

# --- 必填 -------------------------------------------------------------------

# openssl rand -hex 64
# 不要每次重啟都換 —— 換掉之後所有 session 會失效,大家要重新登入
SECRET_KEY_BASE=

# admin 帳密。沒有 admin 資料表,就是這一組。
# 任一為空時 admin 登入一律失敗。
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- 可選,不寫就用 docker-compose.yml 裡的預設值 ----------------------------

# 主機端要開哪個 port(容器內固定 80)
#APP_PORT=3000

# 新項目幾天後過期。0 = 永不過期
#DEFAULT_TTL_DAYS=7

# 單檔上限(MB)
#MAX_UPLOAD_MB=2048

# 1 = 強制 HTTPS + secure cookie。放到公開網路時設 1,
# 並在前面擺一台終結 TLS 的 reverse proxy。
# LAN / Tailscale 上的純 HTTP 維持 0。
#FORCE_SSL=0

# direct upload 的 PUT 會佔住一條 thread 直到傳完
#RAILS_MAX_THREADS=5

#TZ=Asia/Taipei

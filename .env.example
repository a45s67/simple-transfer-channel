# Copy to .env and fill in. .env is not version controlled -- each machine keeps
# its own.
#
#   cp .env.example .env
#   sed -i "s|^SECRET_KEY_BASE=.*|SECRET_KEY_BASE=$(openssl rand -hex 64)|" .env
#   # then set ADMIN_PASSWORD

# --- Required ---------------------------------------------------------------

# openssl rand -hex 64
# Don't rotate this on every restart -- doing so invalidates every session and
# signs everyone out.
SECRET_KEY_BASE=

# Admin credentials. There is no admin table; this is the only pair.
# If either is blank, every admin login attempt fails.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Optional: omit to use the defaults in docker-compose.yml ---------------

# Host port to publish on (the container always listens on 80)
#APP_PORT=3000

# Days until a new item expires. 0 = never
#DEFAULT_TTL_DAYS=7

# Per-file upload limit, in MB
#MAX_UPLOAD_MB=2048

# 1 = force HTTPS and secure cookies. Set this when the site is reachable from
# the public internet, and put a TLS-terminating reverse proxy in front of it.
# Leave at 0 for plain HTTP on a LAN or Tailscale.
#FORCE_SSL=0

# A direct upload's PUT holds a thread for the whole transfer
#RAILS_MAX_THREADS=5

#TZ=Asia/Taipei

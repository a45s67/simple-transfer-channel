<%# GOTCHAS.md 第 5 條:這個 partial 會被 model 層的 broadcast 渲染,沒有 controller %>
<%# context。只能用 item 這個 local,路徑從 item.channel.name 推,不要碰 %>
<%# current_channel / session / 任何依賴請求狀態的 helper。 %>
<%= tag.div id: dom_id(item), class: "item", data: { controller: "clipboard" } do %>
  <div class="meta">
    <% if item.file? %>
      <div class="name"><%= item.file.filename %></div>
      <div class="muted">
        <%= number_to_human_size(item.file.byte_size) %> ·
        <%= l item.created_at, format: :short %>
      </div>
    <% else %>
      <%# 純文字輸出,ERB 會 escape —— <script> 只會被顯示,不會執行 %>
      <pre data-clipboard-target="source"><%= item.body %></pre>
      <div class="muted"><%= l item.created_at, format: :short %></div>
    <% end %>
  </div>

  <div class="acts">
    <% if item.file? %>
      <%= link_to "下載", download_channel_item_path(name: item.channel.name, id: item.id) %>
    <% else %>
      <button type="button" class="ghost"
              data-action="clipboard#copy"
              data-clipboard-target="button">複製</button>
    <% end %>
    <%= button_to "刪除", channel_item_path(name: item.channel.name, id: item.id),
                  method: :delete, class: "danger",
                  form: { data: { turbo_confirm: "確定刪除?" } } %>
  </div>
<% end %>
